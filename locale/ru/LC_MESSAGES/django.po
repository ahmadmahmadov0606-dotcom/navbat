msgid "Choose a category."
msgstr "Выберите категорию."

msgid "Enter a date in the format YYYY-MM-DD."
msgstr "Введите дату в формате ГГГГ-ММ-ДД."

msgid "Enter a valid phone number, e.g. +992 90 123 4567."
msgstr "Введите правильный номер телефона, например +992 90 123 4567."

msgid "Enter the name at least in one language."
msgstr "Введите название хотя бы на одном языке."

msgid "Enter the name of your business."
msgstr "Введите название вашего бизнеса."

msgid "Error."
msgstr "Ошибка."

msgid "Invalid data."
msgstr "Неверные данные."

msgid "Invalid id."
msgstr "Неверный идентификатор."

msgid "Not found."
msgstr "Не найдено."

msgid "Only pending or confirmed bookings can be cancelled."
msgstr "Отменить можно только ожидающую или подтверждённую запись."

msgid "Only providers can do this. Register as a provider first."
msgstr ""
"Это доступно только специалистам. Сначала зарегистрируйтесь как специалист."

msgid "Only providers can see bookings made to them."
msgstr "Записи к себе могут видеть только специалисты."

msgid "The end time must be later than the start time."
msgstr "Время окончания должно быть позже времени начала."

msgid "These hours overlap with other working hours on the same day."
msgstr "Эти часы пересекаются с другими часами работы в этот день."

msgid "This day is already marked as a day off."
msgstr "Этот день уже отмечен как выходной."

msgid "This object is used by other records and cannot be deleted."
msgstr "Этот объект используется в других записях и не может быть удалён."

msgid "This provider has no services yet."
msgstr "У этого специалиста пока нет услуг."

msgid "This provider has no such service."
msgstr "У этого специалиста нет такой услуги."

msgid "This service is not available."
msgstr "Эта услуга недоступна."

msgid "This time is not available. Please choose another slot."
msgstr "Это время недоступно. Выберите другое время."

msgid "Unknown city."
msgstr "Неизвестный город."

msgid "Unknown status."
msgstr "Неизвестный статус."

msgid "You already have another booking at this time."
msgstr "У вас уже есть другая запись на это время."

msgid "You can leave a review only after the visit is done."
msgstr "Оставить отзыв можно только после завершения визита."

msgid "You can only cancel your booking."
msgstr "Вы можете только отменить свою запись."

msgid "You can review only your own bookings."
msgstr "Отзыв можно оставить только к своим записям."

msgid "You cannot book a time in the past."
msgstr "Нельзя записаться на прошлое время."

msgid "You cannot book your own service."
msgstr "Нельзя записаться на свою собственную услугу."

msgid "You have already reviewed this booking."
msgstr "Вы уже оставили отзыв к этой записи."

msgid "No active account found with the given credentials"
msgstr "Не найдено активной учетной записи с указанными данными"

msgid "No active account found for the given token."
msgstr "Не найдено активной учетной записи для этого токена."

msgid "Given token not valid for any token type"
msgstr "Данный токен недействителен для любого типа токена"

msgid "Token is invalid or expired"
msgstr "Токен недействителен или просрочен"

msgid "Token is invalid"
msgstr "Токен недействителен"

msgid "Token is expired"
msgstr "Токен просрочен"

msgid "Token is blacklisted"
msgstr "Токен занесён в чёрный список"

msgid "Token has wrong type"
msgstr "Токен имеет неправильный тип"

msgid "Token has no type"
msgstr "Токен не содержит тип"

msgid "Token has no id"
msgstr "Токен не содержит идентификатор"

msgid "Token contained no recognizable user identification"
msgstr "Токен не содержит идентификатор пользователя"

msgid "Authorization header must contain two space-delimited values"
msgstr ""
"Заголовок авторизации должен содержать два значения, разделённых пробелом"

msgid "User not found"
msgstr "Пользователь не найден"

msgid "User is inactive"
msgstr "Пользователь неактивен"

msgid "%(n)d provider"
msgid_plural "%(n)d providers"
msgstr[0] "%(n)d специалист"
msgstr[1] "%(n)d специалиста"
msgstr[2] "%(n)d специалистов"

msgid "Sign in to see your saved specialists."
msgstr "Войдите, чтобы увидеть сохранённых специалистов."

msgid "Only pending or confirmed bookings can be moved."
msgstr "Перенести можно только ожидающую или подтверждённую запись."

msgid "The current password is wrong."
msgstr "Текущий пароль неверный."

msgid "favorite"
msgstr "избранное"

msgid "favorites"
msgstr "избранное"

msgid "The AI assistant is not configured yet."
msgstr "ИИ-помощник ещё не настроен."

msgid "The AI assistant is busy. Please try again in a minute."
msgstr "ИИ-помощник занят. Попробуйте через минуту."

msgid "The AI assistant is not available now. Please try again later."
msgstr "ИИ-помощник сейчас недоступен. Попробуйте позже."

msgid ""
"Sorry, I can't help with that. Try asking about a service, a city or a day."
msgstr ""
"Извините, с этим я помочь не могу. Спросите об услуге, городе или дне."

msgid "Invalid coordinates."
msgstr "Неверные координаты."

msgid "latitude"
msgstr "широта"

msgid "longitude"
msgstr "долгота"

msgid "This account is not a specialist. Register as a specialist first."
msgstr ""
"Этот аккаунт не специалиста. Сначала зарегистрируйтесь как специалист."

msgid "This account is not an administrator."
msgstr "Этот аккаунт не администратора."
