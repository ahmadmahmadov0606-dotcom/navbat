SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=*
# production: https://navbat.example.tj
CSRF_TRUSTED_ORIGINS=
# only if the frontend is served from another domain
CORS_ALLOWED_ORIGINS=

# PostgreSQL. If POSTGRES_DB is empty, SQLite (db.sqlite3) is used.
# docker-compose sets these itself.
POSTGRES_DB=
POSTGRES_USER=navbat
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Shared cache for several gunicorn workers (docker-compose sets it). Empty = in-memory cache.
REDIS_URL=
CATALOG_CACHE_SECONDS=45
AUTH_THROTTLE_RATE=10/min

# production security (used when DEBUG=0)
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0

# AI assistant: GEMINI_API_KEY (https://aistudio.google.com/apikey) or ANTHROPIC_API_KEY (https://console.anthropic.com)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ASSISTANT_THROTTLE_RATE=30/hour
